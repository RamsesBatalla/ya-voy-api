# URLs de los frontends (para CORS en producción)
FRONTEND_RESTAURANTE=https://restaurante.ya-voy.com
FRONTEND_USUARIO=https://usuario.ya-voy.com
FRONTEND_REPARTIDOR=https://repartidor.ya-voy.com
